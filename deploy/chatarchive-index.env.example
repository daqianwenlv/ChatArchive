# Optional legacy bridge: needs a remote chatlog directory and a local
# WeCom archive with the schema described in docs/DEPLOYMENT.md.
CHATARCHIVE_SOURCE_HOST=archive-reader@example.invalid
CHATARCHIVE_SSH_IDENTITY=/etc/chatarchive/source_ed25519
CHATARCHIVE_CHATLOG_ROOT=/srv/chatlog/store
CHATARCHIVE_WECOM_DB=/srv/wecom/archive.sqlite3
# Optional: remote directory that relative media_path values resolve against
# (defaults to CHATARCHIVE_CHATLOG_ROOT). Paths outside it are never read.
#CHATARCHIVE_MEDIA_ROOT=/srv/chatlog/store

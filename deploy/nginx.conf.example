# Mount at /ChatArchive/ in your existing HTTPS server block.
# Match CHATARCHIVE_BASE_URL to the public URL, including this path prefix.
# For Docker, leave CHATARCHIVE_TRUST_PROXY=0. The API verifies local sessions.
location = /ChatArchive { return 301 /ChatArchive/; }
location ^~ /ChatArchive/query/ {
    proxy_pass http://127.0.0.1:8769/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Auth-Oid "";
    proxy_set_header X-Auth-Role "";
    proxy_set_header X-ChatArchive-Machine "1";
    proxy_set_header Cookie "";
    client_max_body_size 256k;
    access_log off;
}
location = /ChatArchive/mcp { return 308 /ChatArchive/mcp/; }
location ^~ /ChatArchive/mcp/ {
    proxy_pass http://127.0.0.1:8769/mcp/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Auth-Oid "";
    proxy_set_header X-Auth-Role "";
    proxy_set_header Cookie "";
    proxy_buffering off;
    proxy_read_timeout 90s;
    client_max_body_size 256k;
    access_log off;
}
location ^~ /ChatArchive/ {
    proxy_pass http://127.0.0.1:8769/;
    proxy_set_header Host $host;
    proxy_set_header X-Auth-Oid "";
    proxy_set_header X-Auth-Role "";
    proxy_set_header X-ChatArchive-Machine "";
    client_max_body_size 256k;
    access_log off;
}

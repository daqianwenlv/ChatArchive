CHATARCHIVE_DATA=./var
# Docker host port; keep BASE_URL consistent with the URL in your browser.
CHATARCHIVE_PORT=8769
CHATARCHIVE_BASE_URL=http://127.0.0.1:8769
CHATARCHIVE_TIMEZONE=Asia/Shanghai
# Optional public PyPI mirror for image builds; official distribution hashes are still required.
CHATARCHIVE_PIP_INDEX_URL=https://pypi.org/simple
# Optional emergency API bearer (32+ random characters), not a browser password.
# Browser account: python -m chatarchive.accounts create admin
CHATARCHIVE_ADMIN_TOKEN=
# Only enable behind a trusted proxy which authenticates administrators,
# overwrites X-Auth-Role/X-Auth-Oid and connects from localhost.
CHATARCHIVE_TRUST_PROXY=0

# Optional AI service (Chat Completions JSON-compatible). Configure on the server only.
# Discovery sends only the request; planning adds the selected group directory.
# Content-analysis steps
# send up to 100 matching message excerpts to this explicitly configured service.
# Group catalogue proposals and classification send group names, frequent terms
# and up to 8 short message excerpts per group.
CHATARCHIVE_AI_BASE_URL=
CHATARCHIVE_AI_MODEL=
CHATARCHIVE_AI_API_KEY=
